
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Little Surprise for Khushi ❤️</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  background: #fce8ef;
  font-family: Georgia, serif;
  color: #a64d79;
  display: grid;
  place-items: center;
  padding: 20px;
}
.card {
  background: #fff9fc;
  border: 2px dashed #e9a4c1;
  border-radius: 28px;
  padding: 35px 22px;
  text-align: center;
  max-width: 520px;
  width: 100%;
  box-shadow: 0 12px 35px #d9a5ba55;
}
.flowers { font-size: 40px; }
h1 { font-size: 34px; }
p { font-size: 19px; line-height: 1.7; }
button {
  border: 0;
  background: #e58db4;
  color: white;
  padding: 14px 27px;
  border-radius: 30px;
  font-size: 17px;
  margin: 8px;
}
#response { margin-top: 25px; }
</style>
</head>
<body>
<div class="card">
  <div class="flowers">🎀 💗 🌷</div>
  <h1>A little surprise for you!</h1>
  <h2>Hey Khushi! ❤️</h2>
  <p>Someone made a little something special just for you...</p>
  <button onclick="nextPage()">Open your surprise 💌</button>
  <div id="page2" style="display:none">
    <h2>Hey Khushi! 🧸</h2>
    <p>Do you wanna see your surprise? 🥺</p>
    <button onclick="yesClick()">YES! ❤️</button>
    <button onclick="noClick()">NO 🙈</button>
    <div id="response"></div>
  </div>
</div>
<script>
function nextPage() {
  document.getElementById("page2").style.display = "block";
}
function yesClick() {
  document.getElementById("response").innerHTML =
    "YAYYYY! 🥳 The best is yet to come! 💗";
}
function noClick() {
  document.getElementById("response").innerHTML =
    "Are you sure Khushi? 🥺 Try YES! 💕";
}
</script>
</body>
</html>
